{
    "name": "polirium-erp",
    "version": "1.0.0",
    "private": true,
    "workspaces": {
        "packages": [
            "platform/core/*",
            "platform/packages/*",
            "platform/modules/*"
        ]
    },
    "scripts": {
        "dev": "npm run development",
        "development": "node scripts/build-assets.mjs",
        "watch": "node scripts/build-assets.mjs --watch",
        "watch-poll": "node scripts/build-assets.mjs --watch",
        "hot": "node scripts/build-assets.mjs --watch",
        "prod": "npm run production",
        "production": "node scripts/build-assets.mjs --production"
    },
    "devDependencies": {
        "esbuild": "^0.28.2",
        "sass": "~1.102.0"
    },
    "packageManager": "npm@12.0.2",
    "engines": {
        "node": ">=22.12.0",
        "npm": ">=10.0.0"
    },
    "dependencies": {
        "cropperjs": "^1.6.2"
    },
    "overrides": {
        "rollup": "4.62.4"
    },
    "allowScripts": {
        "esbuild@0.28.2": true,
        "esbuild@0.25.12": true,
        "cypress@15.20.1": true,
        "@parcel/watcher@2.6.0": true,
        "fsevents@2.3.3": true,
        "core-js": false,
        "core-js-pure": false
    }
}
